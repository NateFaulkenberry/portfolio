{
  "name": "nate-faulkenberry-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Nate Faulkenberry's Portfolio — a statically exported Next.js site deployed to GitHub Pages.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run pdf",
    "pdf": "node scripts/build-pdfs.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "verify": "node scripts/verify-export.mjs",
    "check": "npm run typecheck && npm run lint && npm run build && npm run verify"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0"
  }
}
